# Central InfluxDB 3 connection (server-side only — never exposed to the browser).
INFLUX_HOST=http://localhost:8181
INFLUX_TOKEN=apiv3_your_admin_or_read_token_here
INFLUX_DATABASE=mtr

# Optional panel + API password (HTTP Basic auth, username: admin).
# Leave empty to disable authentication. Use HTTPS outside a trusted network.
PANEL_PASSWORD=
